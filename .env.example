# Project "Relief" — Environment Variables
# Copy this file to .env and fill in your values

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps (Android SDK only for current development)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-sdk-api-key

# Payment state — safe defaults; QA override only belongs in a disposable QA build
EXPO_PUBLIC_RELIEF_TEST_MODE=false
EXPO_PUBLIC_PAYMENTS_ENABLED=false
EXPO_PUBLIC_QA_PREMIUM_OVERRIDE=false

# RevenueCat (In-App Purchases)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-api-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-api-key

# NOTE: SUPABASE_DB_URL (PostgreSQL direct connection) is a server-side-only
# secret used by tools/facility-import/. It must NEVER be added here or
# prefixed with EXPO_PUBLIC_ — it would be bundled into the app binary.
